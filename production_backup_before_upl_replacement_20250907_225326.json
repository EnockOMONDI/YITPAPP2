  "pk": 90,
  "fields": {
    "module": 12,
    "title": "Lesson 4: Overcoming Obstacles to Purpose",
    "content_type": "text",
    "content": "<h2>Objective</h2><p>Push through internal and external challenges.</p><h3>Key Ideas</h3><ul><li>Folktale: Tortoise and the Heavy Load.</li><li>Fear vs. faith; courage in adversity.</li><li>Building inner clarity.</li></ul><h3>Activity</h3><p>Visualization: picture breaking through a major barrier.</p>",
    "video_url": "",
