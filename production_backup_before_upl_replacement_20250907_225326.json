{
  "model": "courses.lesson",
  "pk": 87,
  "fields": {
    "module": 12,
    "title": "Lesson 1: Introduction to Life’s Purpose",
    "content_type": "text",
    "content": "<h2>Objective</h2><p>Understand what purpose means and why it matters.</p><h3>Key Ideas</h3><ul><li>The Story of the Three Builders (cathedral vision).</li><li>7 Questions for Clarity.</li><li>Purpose → Vision → Goals; exemplars: Gandhi, Mandela, Mother Teresa.</li></ul><h3>Activity</h3><p>Reflective journaling: “When did I feel most alive and fulfilled?”</p>",
    "video_url": "",
    "document_url": "",
    "audio_url": "",
    "presentation_file": "",
    "sort_order": 1,
    "is_published": true,
    "is_mandatory": true,
    "estimated_duration": 60,
    "learning_objectives": "Define life purpose; distinguish purpose, vision, and goals; identify personal clarity signals.",
    "resources": [
      {
        "url": "https://example.com/gandhi-context",
        "label": "Gandhi quote & context"
      }
    ],
    "created_at": "2025-08-23T19:05:02.889Z",
    "updated_at": "2025-08-23T19:05:02.954Z"
  }
},
{
  "model": "courses.lesson",
  "pk": 88,
  "fields": {
    "module": 12,
    "title": "Lesson 2: Foundations of Purpose",
    "content_type": "text",
    "content": "<h2>Objective</h2><p>Explore foundational principles for finding purpose.</p><h3>Key Ideas</h3><ul><li>Baobab “Tree of Life” — service and sustenance.</li><li>Napoleon Hill: Definiteness of Purpose — get clear, fuel desire, act daily.</li><li>Zig Ziglar’s Wheel of Life — balanced growth across domains.</li></ul><h3>Activity</h3><p>Rate your Wheel of Life and identify one improvement in each spoke.</p>",
    "video_url": "",
    "document_url": "",
    "audio_url": "",
    "presentation_file": "",
    "sort_order": 2,
    "is_published": true,
    "is_mandatory": true,
    "estimated_duration": 90,
    "learning_objectives": "Explain ‘definiteness of purpose’; connect purpose to service; apply the Wheel of Life.",
    "resources": [
      {
        "url": "https://www.oneearth.org/species-of-the-week-african-baobab-tree/",
        "label": "African Baobab (One Earth)"
      }
    ],
    "created_at": "2025-08-23T19:05:04.647Z",
    "updated_at": "2025-08-23T19:05:04.657Z"
  }
},
{
  "model": "courses.lesson",
  "pk": 89,
  "fields": {
    "module": 12,
    "title": "Lesson 3: Purpose and Service",
    "content_type": "text",
    "content": "<h2>Objective</h2><p>Connect personal purpose to service.</p><h3>Key Ideas</h3><ul><li>“Send the Elevator Back Down” proverb — mentorship and opportunity.</li><li>Lessons from Mother Teresa and Nelson Mandela.</li><li>Humility and selflessness as foundations of service.</li></ul><h3>Activity</h3><p>Reflection: Who are you serving today and how?</p>",
    "video_url": "",
    "document_url": "",
    "audio_url": "",
    "presentation_file": "",
    "sort_order": 3,
    "is_published": true,
    "is_mandatory": true,
    "estimated_duration": 60,
    "learning_objectives": "Describe how service multiplies impact; identify practical acts of daily service.",
    "resources": [],
    "created_at": "2025-08-23T19:05:05.898Z",
