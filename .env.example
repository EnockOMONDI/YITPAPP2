# =============================================================================
# YITP LMS ENVIRONMENT TEMPLATE
# =============================================================================
# Template values only. Do not commit real credentials.

# =============================================================================
# DJANGO CORE SETTINGS
# =============================================================================
DEBUG=False
SECRET_KEY=change_me_to_a_random_secret_key
ALLOWED_HOSTS=www.youthimpactglobal.com,youthimpactglobal.com,*.youthimpactglobal.com,yitpapp2.onrender.com,*.onrender.com
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=your_database_host
DB_PORT=5432
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email_user@example.com
EMAIL_HOST_PASSWORD=your_email_app_password
DEFAULT_FROM_EMAIL=YOUTH IMPACT GLOBAL <noreply@example.com>
MPESA_CONSUMER_KEY=mpesa_consumer_key
MPESA_CONSUMER_SECRET=mpesa_consumer_secret
MPESA_ENVIRONMENT=sandbox
MPESA_SHORTCODE=mpesa_shortcode
MPESA_PASSKEY=mpesa_passkey
SITE_URL=https://www.youthimpactglobal.com
ADMIN_EMAIL=admin@example.com
STATIC_URL=/static/
STATIC_ROOT=staticfiles
UPLOADCARE_PUBLIC_KEY=uploadcare_public_key
UPLOADCARE_SECRET_KEY=uploadcare_secret_key
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
LOG_LEVEL=INFO
CACHE_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
SENTRY_DSN=your-sentry-dsn-here-for-error-tracking
PAYPAL_CLIENT_ID=paypal_client_id
PAYPAL_CLIENT_SECRET=paypal_client_secret
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=paypal_webhook_id

# TinyMCE API Key for Rich Text Editor
TINYMCE_API_KEY=tinymce_api_key

# Development Environment Variables
DJANGO_ENV=development
