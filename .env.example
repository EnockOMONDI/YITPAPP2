

# =============================================================================
# YITP LMS ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains environment variables for the YITP LMS application
# Copy this file to .env and update the values for your environment

# =============================================================================
# DJANGO CORE SETTINGS
# =============================================================================
DEBUG=False
SECRET_KEY=your-secret-key-here-generate-a-long-random-string-for-production
ALLOWED_HOSTS=yitp-lms.onrender.com,*.onrender.com,localhost,127.0.0.1

# =============================================================================
# DATABASE CONFIGURATION (Neon PostgreSQL)
# =============================================================================
DB_NAME=yitplms
DB_USER=yitplms_owner
DB_PASSWORD=your-database-password-here
DB_HOST=ep-spring-block-a5drxziv-pooler.us-east-2.aws.neon.tech
DB_PORT=5432

# =============================================================================
# EMAIL CONFIGURATION (Gmail SMTP)
# =============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password-here
DEFAULT_FROM_EMAIL=YOUTH IMPACT GLOBAL <your-email@gmail.com>

# =============================================================================
# M-PESA API CONFIGURATION
# =============================================================================
MPESA_CONSUMER_KEY=your-mpesa-consumer-key-here
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret-here
MPESA_ENVIRONMENT=sandbox
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-mpesa-passkey-here

# =============================================================================
# SITE CONFIGURATION
# =============================================================================
SITE_URL=https://yitp-lms.onrender.com
ADMIN_EMAIL=youthimpactglobal3@gmail.com

# =============================================================================
# STATIC FILES CONFIGURATION
# =============================================================================
STATIC_URL=/static/
STATIC_ROOT=staticfiles

# =============================================================================
# UPLOADCARE CONFIGURATION (Optional)
# =============================================================================
UPLOADCARE_PUBLIC_KEY=18ad19435c41077ca842
UPLOADCARE_SECRET_KEY=b27f8995d2e4b66cbf02

# =============================================================================
# SECURITY SETTINGS (Production)
# =============================================================================
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
